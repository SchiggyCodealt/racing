#!/usr/bin/env python
# SConstruct: builds Track Rush's native library (FleetSim, see README.md) into
# ../bin/libtrackrush.<platform>.<target>.<arch>.<so|dll>, the files trackrush.gdextension names.
#
#   scons platform=linux target=template_release            (from this folder)
#   scons platform=windows use_mingw=yes target=template_release
#
# godot-cpp (tag godot-4.5-stable) is looked for in ./godot-cpp, or where GODOT_CPP points.
# build_profile.json limits godot-cpp to the engine classes FleetSim uses (much faster builds).
import os

godot_cpp = os.environ.get("GODOT_CPP", "godot-cpp")
if "build_profile" not in ARGUMENTS:
    ARGUMENTS["build_profile"] = os.path.abspath("build_profile.json")
env = SConscript(os.path.join(godot_cpp, "SConstruct"))

env.Append(CPPPATH=["src/"])
if env.get("is_msvc", False):
    env.Append(CCFLAGS=["/fp:precise"])
else:
    # no fused multiply-adds: they round differently from GDScript's separate * and +
    env.Append(CCFLAGS=["-ffp-contract=off"])

sources = Glob("src/*.cpp")
out_dir = ARGUMENTS.get("out", "../bin")  # (out= is also reported as unknown by godot-cpp: harmless)
library = env.SharedLibrary(
    os.path.join(out_dir, "libtrackrush{}{}".format(env["suffix"], env["SHLIBSUFFIX"])),
    source=sources,
)
Default(library)
